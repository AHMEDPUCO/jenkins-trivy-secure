{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:base"],
  "automerge": true,
  "platformAutomerge": true,
  "labels": ["dependencies", "renovate"],
  "reviewers": ["AHMEDPUCO"],
  "assignees": ["AHMEDPUCO"],
  "docker": {
    "pinDigests": false
  },
  "packageRules": [
    {
      "matchUpdateTypes": ["patch", "minor"],
      "automerge": true
    },
    {
      "matchPackagePatterns": ["nginx", "alpine"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    }
  ]
}
